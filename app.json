{
  "expo": {
    "name": "AclaraDoc",
    "slug": "aclaradoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icons/app-icon-1024.png",
    "scheme": "aclaradoc",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/icons/app-icon-1024.png"
    },
    "android": {
      "package": "com.sigleto.aclaradoc",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#092B60",
        "foregroundImage": "./assets/branding/icons/android-foreground.png",
        "backgroundImage": "./assets/branding/icons/android-background.png",
        "monochromeImage": "./assets/branding/icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona las p?ginas que quieres revisar en AclaraDoc.",
          "cameraPermission": "AclaraDoc usa la c?mara para fotografiar las p?ginas de tu documento.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0916e36-5637-4149-b76e-e349f555bf2b"
      }
    },
    "owner": "sigleto"
  }
}
