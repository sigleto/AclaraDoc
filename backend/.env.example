# Solo este archivo de ejemplo se versiona. No escribir la clave en Expo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# mock no llama a Google. Cambiar a gemini solo tras verificar el proyecto gratuito.
ANALYSIS_MODE=mock
# Confirmación manual: el proyecto de la clave NO tiene facturación habilitada.
FREE_TIER_CONFIRMED=false
HOST=127.0.0.1
PORT=3001
# Orígenes web exactos, separados por comas. Las apps nativas no envían Origin.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
