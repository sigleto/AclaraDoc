# Solo este archivo de ejemplo se versiona. No escribir la clave en Expo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# mock no llama a Google. Cambiar a gemini solo tras verificar el proyecto gratuito.
ANALYSIS_MODE=mock
# Confirmación manual: el proyecto de la clave NO tiene facturación habilitada.
FREE_TIER_CONFIRMED=false
HOST=127.0.0.1
PORT=3001
# Orígenes web exactos, separados por comas. Las apps nativas no envían Origin.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Almacenamiento: memory para mock/pruebas, sqlite local, postgres para Render/Neon.
# Si se omite: mock usa memory y gemini usa sqlite (compatibilidad local).
# Descomentar solo la selección deseada; postgres no cambia a memoria si falla.
# QUOTA_STORE=sqlite
# Secreto: solo backend/.env o entorno privado del servidor, nunca Expo ni Git.
DATABASE_URL=
# IP/CIDR de proxies comprobados, separados por comas. Vacío no confía en XFF.
# No adivinar saltos o rangos para Render; ver backend/DEPLOYMENT.md.
TRUST_PROXY_CIDRS=

# Cuotas. Valores inválidos o ausentes usan los predeterminados seguros.
IP_WINDOW_MINUTES=15
IP_REQUEST_LIMIT=5
DEVICE_DAILY_LIMIT=3
GLOBAL_DAILY_LIMIT=20
MAX_CONCURRENT_ANALYSES=2
QUOTA_COOLDOWN_MINUTES=60
QUOTA_RETENTION_DAYS=7
QUOTA_CLEANUP_MINUTES=1
# Obligatorio en gemini: secreto aleatorio independiente de la clave de Google.
# Generar sin imprimirlo con: npm run quota:secret --workspace backend
QUOTA_HASH_SECRET=

# Límites técnicos; solo pueden reducirse dentro de los rangos del README.
ANALYSIS_TIMEOUT_SECONDS=45
UPLOAD_TIMEOUT_SECONDS=30
HEADERS_TIMEOUT_SECONDS=15
MAX_OUTPUT_TOKENS=6000
MAX_RESPONSE_CHARS=70000
MAX_FILES=6
MAX_PAGES=6
MAX_FILE_BYTES=4194304
MAX_TOTAL_BYTES=10485760
MULTIPART_HEADER_PAIRS=30
PDF_TIMEOUT_MS=3000
PDF_OLD_MEMORY_MB=64
PDF_YOUNG_MEMORY_MB=16
SQLITE_BUSY_TIMEOUT_MS=1000
